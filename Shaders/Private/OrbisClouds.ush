// RAY SPHARE INTERSECTION AND CLOUD SHELL DEFINITION-----------------------------------------------

// Builds the world-space view direction for this pixel — unit vector from the camera through the pixel into the scene.
// Called from OrbisClouds.usf with ScreenPos from UVAndScreenPos.zw (FScreenPassVS fullscreen pass).
//
// float3(ScreenPos, 1) — UE screen position as (x, y, 1); the 1 is homogeneous w for the screen-to-world transform.
// PrimaryView.ScreenToWorld — 3x3 part of the view matrix that maps screen vectors to world space (camera-relative here, RayOrigin is 0).
// DFToFloat3x3(PrimaryView.ScreenToWorld) — converts the matrix to float3x3 for the multiply.
// mul(float3(ScreenPos, 1), DFToFloat3x3(PrimaryView.ScreenToWorld)) — maps that screen direction into world space; result is not unit length.
// .xyz — take the direction part (drop w if present).
// normalize(...) — unit length so t along the ray is distance in cm (matches RaySphereIntersection).
float3 ReconstructWorldRayDirection(float2 ScreenPos)
{
	return normalize(mul(float3(ScreenPos, 1), DFToFloat3x3(PrimaryView.ScreenToWorld)).xyz);
}

/**
 * At distance t along RayDirection from the camera (RayOrigin is 0), returns how far that sample point
 * is from PlanetCenter — the spherical radius at that march step.
 *
 * Why not length(t * RayDirection - PlanetCenter):
 * At planet scale (~1e6 cm and up), subtracting two huge vectors loses float32 precision.
 * This uses the expanded form of |t * RayDirection - PlanetCenter|^2 instead:
 *
 * t * t — along-ray term
 * 2.0 * t * dot(RayDirection, OC) — cross term (OC = -PlanetCenter)
 * dot(OC, OC) — squared distance from camera to planet center
 *
 * Then sqrt gives radius. max(..., 0.0) avoids negative from float error.
 *
 * Used by OrbisCloudsDensityAt during the march — radius vs InnerRadius / OuterRadius sets fog density at each step.
 *
 * Needed at large planets: with camera at 0 and PlanetCenter at ~1e6–1e9 cm,
 * length(t * RayDirection - PlanetCenter) subtracts two huge, nearly parallel vectors → radius and density can wobble or band.
 * Small local clouds (km scale): plain length is usually fine.
 * Planet-sized radii in camera-relative space: keep this expanded form.
 */
float SampleRadiusAlongRay(float t, float3 RayDirection, float3 PlanetCenter)
{
	const float3 OC = -PlanetCenter;
	return sqrt(max(t * t + 2.0 * t * dot(RayDirection, OC) + dot(OC, OC), 0.0));
}

// Precisely computes the unit direction from the planet center to a point t units along RayDirection from
// the camera (RayOrigin is always (0,0,0) in this shader) — used both for the outer-shell hit point
// (t = OuterShellPosition in MainPS's Coverage/Type projection) and for individual raymarch step positions
// (t = the per-step ray distance in the Clouds raymarch loop). Doesn't re-derive where t comes from at all
// — whoever calls this has already decided t (via IntersectAtmosphereShell for the shell hit, or the
// raymarch's own step loop), so this can't disagree with that.
//
// Was: normalize(RayDirection * t - PlanetCenterRelative) — subtracts two float3 vectors that are both
// ~CameraDistanceFromPlanetCenter in magnitude and nearly parallel whenever the camera is far from the
// planet, losing the precision needed to recover their small difference. For the outer-shell case this
// collapsed the weather-map sampling position to a near-constant value across the whole visible disc from
// deep space (the flat white/grey "surface" bug); the raymarch loop has the identical pattern and the same
// exposure whenever the camera is far from the planet. Fixed using UE's double-float math
// (FDFVector3/FDFScalar, DoubleFloat.ush) for just the multiply and subtract, only demoting to plain
// float32 at the very end once the result's magnitude is safely bounded by the sphere radius involved —
// modeled on the same technique Epic's own RayPlanetIntersectPrecise
// (Engine/Shaders/Private/PathTracing/Volume/PathTracingAtmosphere.ush) uses for the path-traced
// atmosphere's ray/sphere intersection.
//
// PlanetCenterRelativeDF is the planet center relative to the camera, constructed on the CPU from a
// double-precision FVector via FDFVector3, so it never loses precision before this function runs.
float3 ComputePreciseDirectionFromPlanetCenter(float3 RayDirection, float t, FDFVector3 PlanetCenterRelativeDF)
{
	const FDFVector3 PositionRelativeToCamera = DFMultiply(RayDirection, DFPromote(t));
	const FDFVector3 PositionRelativeToPlanetCenter = DFSubtract(PositionRelativeToCamera, PlanetCenterRelativeDF);
	return normalize(DFDemote(PositionRelativeToPlanetCenter));
}

// IQ sphere intersector: https://iquilezles.org/articles/intersectors/
// Sphere of size SphereRadius centered at SphereCenter.
// Returns (tNear, tFar). No hit → (-1, -1).
//
// Was: float B = dot(OriginToCenter, RayDirection); float C = dot(OriginToCenter, OriginToCenter) -
// SphereRadius * SphereRadius; float Discriminant = B * B - C; — subtracts two independently-rounded huge
// squared numbers directly. Fails for grazing/near-tangent rays (common whenever the camera is close to
// the sphere, since a large fraction of screen directions become near-tangent), where the true discriminant
// is naturally near zero and float32 rounding is enough to flip its sign — causing IntersectAtmosphereShell
// to falsely report a miss (discard, black) for those rays even when the camera is comfortably positioned
// to hit the sphere. Replaced with the perpendicular-distance formulation (H = component of OriginToCenter
// perpendicular to RayDirection; Ha = R^2 - |H|^2, mathematically identical to the old Discriminant but
// computed via a path that doesn't independently round two huge squared terms before subtracting them) plus
// the numerically stable quadratic formula (pick Q's sign to avoid cancellation between the two roots, then
// get the second root via the product-of-roots identity C/Q instead of the naive B +/- sqrt(Discriminant)
// form). Same technique as Epic's own RayPlanetIntersectPrecise
// (Engine/Shaders/Private/PathTracing/Volume/PathTracingAtmosphere.ush); this doesn't need the double-float
// math that function also uses, since near-tangent cancellation is angle-driven, not magnitude-driven.
// Verified by hand against a camera-outside case (D=1000, R=100, direct ray: near=900, far=1100) and a
// camera-inside case (D=50, R=100, direct ray: near=-50 behind camera, far=150) before implementing.
float2 IqRaySphereIntersection(float3 RayOrigin, float3 RayDirection, float3 SphereCenter, float SphereRadius)
{
	const float3 OriginToCenter = RayOrigin - SphereCenter;
	const float B = dot(OriginToCenter, RayDirection);
	const float3 H = OriginToCenter - RayDirection * B;
	const float Hd = dot(H, H);
	float Ha = SphereRadius * SphereRadius - Hd;
	if (Ha < 0.0)
	{
		return float2(-1.0, -1.0);
	}
	Ha = sqrt(Ha);

	float Q;
	if (B < 0.0)
	{
		Q = -B + Ha;
	}
	else
	{
		Q = -B - Ha;
	}
	const float C = dot(OriginToCenter, OriginToCenter) - SphereRadius * SphereRadius;
	const float T0 = Q;
	const float T1 = C / Q;
	const float TNear = min(T0, T1);
	const float TFar = max(T0, T1);

	// The two roots' product equals C, which depends only on the camera's distance from the sphere center
	// and the radius — never on RayDirection. So "camera outside the sphere" (C > 0, roots share a sign)
	// versus "camera inside" (C < 0, roots have opposite signs) is a single fact for the whole frame, not
	// something that can vary per pixel. What DOES vary per ray is whether that shared sign is positive (ray
	// points toward the sphere — real hit ahead) or negative (ray points away from it — sphere is entirely
	// behind the camera in that direction, i.e. no hit at all). TFar < 0 here means the LATTER case: both
	// roots behind the camera. Clamping that straight to (0, 0) via max(...,0.) — what this function used to
	// do, and what the original B*B-C version also did — makes IntersectAtmosphereShell's
	// "OuterRadiusHit.x >= 0 && OuterRadiusHit.y >= 0" check pass as a false hit at t=0, rendering a "ghost"
	// wherever the camera's rays happen to point away from the planet, with a real gap of genuine non-hits
	// on either side. Must return an explicit miss here instead.
	if (TFar < 0.0)
	{
		return float2(-1.0, -1.0);
	}
	return float2(max(TNear, 0.), TFar);
}

bool IntersectAtmosphereShell(
	float3 RayOrigin,
	float3 RayDirection,
	float3 PlanetCenter,
	float InnerRadius,
	float OuterRadius,
	out float tRaymarchEnter,
	out float tRaymarchExit,
	out float2 OuterRadiusHitOut)
{

	const float2 InnerHit = IqRaySphereIntersection(RayOrigin, RayDirection, PlanetCenter, InnerRadius);
	const float2 OuterRadiusHit = IqRaySphereIntersection(RayOrigin, RayDirection, PlanetCenter, OuterRadius);
	OuterRadiusHitOut = OuterRadiusHit;

	if (OuterRadiusHit.x >= 0. && OuterRadiusHit.y >= 0.)
	{
		// intersected outer sphere
		tRaymarchEnter = OuterRadiusHit.x;
		tRaymarchExit = OuterRadiusHit.y;

		if (InnerHit.x >= 0. && InnerHit.y >= 0.)
		{
			// intersected inner sphere
			const float3 OriginToCenter = RayOrigin - PlanetCenter;
			const bool bCameraInsideInner = dot(OriginToCenter, OriginToCenter) < (InnerRadius * InnerRadius);

			if (bCameraInsideInner)
			{
				// Camera starts below the inner radius: the near inner-sphere root is clamped to 0
				// (behind/at the camera), so use the far root instead — where the ray exits the inner
				// sphere into the shell — as the start of the march.
				tRaymarchEnter = max(InnerHit.x, InnerHit.y);
			}
			else
			{
				// Camera is above the inner radius: stop the shell march at the near inner-sphere hit
				// (the visible ground/inner surface occludes anything beyond it).
				const float MinInner = min(InnerHit.x, InnerHit.y);
				tRaymarchExit = min(tRaymarchExit, MinInner);
			}
		}

		return true;
	}
	else
		return false;
}

// DEPTH OCCLUSION-------------------------------------------------------------------------------------

// SceneViewDepth from the depth texture is NOT distance along this pixel's RayDirection.
// It is how far the surface is along PrimaryView.ViewForward (the camera center axis, cm).
//
// Each pixel has its own RayDirection (from ReconstructWorldRayDirection). On screen edges it tilts away from ViewForward.
// The same surface is a longer distance along RayDirection than along ViewForward.
//
// SceneRayDistance = SceneViewDepth / dot(RayDirection, PrimaryView.ViewForward)
// dot is how aligned RayDirection is with ViewForward (1 = same direction, smaller when tilted).
// Center pixel: dot ~ 1, SceneRayDistance ~ SceneViewDepth. Corner pixel: dot < 1, SceneRayDistance > SceneViewDepth.
//
// ClipShellBySceneDepth compares SceneRayDistance to tRaymarchEnter/tRaymarchExit along RayDirection — without this, edge pixels clip fog at the wrong distance.
float SceneDepthToRayDistance(float SceneViewDepth, float3 RayDirection)
{
	return SceneViewDepth / max(dot(RayDirection, PrimaryView.ViewForward), 1e-5);
}

// Shorten the cloud shell march [tRaymarchEnter, tRaymarchExit] so terrain in the scene depth buffer occludes fog behind it.
void ClipShellBySceneDepth(inout float tRaymarchEnter, inout float tRaymarchExit, float SceneRayDistance)
{
	// Terrain is at or before the shell entry — no cloud on this pixel.
	if (SceneRayDistance <= tRaymarchEnter)
	{
		tRaymarchExit = tRaymarchEnter;
		return;
	}

	// Stop marching at the terrain surface instead of the shell exit.
	tRaymarchExit = min(tRaymarchExit, SceneRayDistance);
}

// RAYMARCHING OPTICAL DEPTH, DENSITY AND CLOUD SHAPES----------------------------------------------

#define ZENITH_MARCH_MIN_STEPS 54  // 64
#define HORIZON_MARCH_MAX_STEPS 96 // 128

// Thin bottom/top fade bands into a flat 1.0 plateau (HZD slide silhouettes).
float ThinEdgeFade(float h, float BottomEdge, float TopEdge)
{
	const float bottom = smoothstep(0.0, BottomEdge, h);
	const float top = 1.0 - smoothstep(1.0 - TopEdge, 1.0, h);
	return bottom * top;
}

float ThinEdgeFade(float h, float Edge)
{
	return ThinEdgeFade(h, Edge, Edge);
}

// Height fraction in shell: 0 at inner radius, 1 at outer radius.
float GetHeightFraction(float Radius, float InnerRadius, float OuterRadius)
{
	const float ShellThickness = OuterRadius - InnerRadius;
	if (ShellThickness <= 0.0)
	{
		return 0.0;
	}

	return saturate((Radius - InnerRadius) / ShellThickness);
}

float HeightPresetStratus(float h)
{
	return ThinEdgeFade(h, 0.08);
}

float HeightPresetCumulus(float h)
{
	const float hc = saturate((h - 0.25) / 0.5);
	return ThinEdgeFade(hc, 0.1);
}

float HeightPresetCumulonimbus(float h)
{
	const float hc = saturate((h - 0.05) / 0.9);
	return ThinEdgeFade(hc, 0.06, 0.12);
}

// Camera-relative space: RayOrigin (camera) is 0, so outward radial "up" at the camera is normalize(-PlanetCenter).
int FindStepCount(float3 RayDirection, float3 PlanetCenter)
{
	const float3 UpVector = normalize(-PlanetCenter); // planet center is input as relative to camera from SceneViewExtension
	const float d = abs(dot(RayDirection, UpVector));
	return (int)ceil(lerp((float)HORIZON_MARCH_MAX_STEPS, (float)ZENITH_MARCH_MIN_STEPS, d));
}

float AccumulateShellOpticalDepth(
	float3 RayDirection,
	float3 PlanetCenter,
	float InnerRadius,
	float OuterRadius,
	float tRaymarchEnter,
	float tRaymarchExit)
{
	const float SegmentLength = tRaymarchExit - tRaymarchEnter;
	if (SegmentLength <= 0.0)
	{
		return 0.0;
	}

	const int StepCount = FindStepCount(RayDirection, PlanetCenter);
	const float StepSize = SegmentLength / StepCount;
	float OpticalDepth = 0.0;

	for (int StepIndex = 0; StepIndex < StepCount; StepIndex++)
	{
		const float t = tRaymarchEnter + (StepIndex + 0.5) * StepSize;
		// OpticalDepth += SampleIsoVolumeDensityAt(t, RayDirection, PlanetCenter, InnerRadius, OuterRadius) * StepSize;
	}

	return OpticalDepth;
}
