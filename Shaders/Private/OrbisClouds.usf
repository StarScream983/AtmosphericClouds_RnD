#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Engine/Private/InstancedStereo.ush"
#include "/Engine/Private/DoubleFloat.ush"
#include "/Engine/Private/RandomPCG.ush"
#include "/Plugin/OrbisClouds/Noise.ush"
#include "/Plugin/OrbisClouds/OrbisClouds.ush"

float3 PlanetCenterRelative;
float3 PlanetCenterRelativeHi;
float3 PlanetCenterRelativeLo;
float InnerRadius;
float OuterRadius;
float CloudDensity;
float CloudCoverageNoiseScale;
uint NoiseSeed;
uint BaseNoiseType;
float NoiseOutputMin;
float NoiseOutputMax;
int CloudsCoverageOctaves;
float CloudsCoverageLacunarity;
float CloudsCoverageGain;
uint bCloudsCoverageUseWarp;
float CloudsCoverageWarpStrength;
int CloudsCoverageWarpOctaves;
float CloudTypeNoiseScale;
uint CloudTypeNoiseSeed;
uint CloudTypeNoiseType;
int CloudsTypeOctaves;
float CloudsTypeLacunarity;
float CloudsTypeGain;
float BaseShapeWorldSpan;
uint CloudsViewMode;
uint bDebugSolid;
uint bDepthOcclusion;

Texture2D SceneDepthTexture;
SamplerState SceneDepthSampler;

Texture3D BaseShapeNoiseTexture;
SamplerState BaseShapeNoiseSampler;
Texture3D DetailNoiseTexture;
SamplerState DetailNoiseSampler;
uint bHasBaseShapeNoiseTexture;
uint bHasDetailNoiseTexture;
Texture2D TiledCoverageMap;
SamplerState TiledCoverageMapSampler;
uint bHasTiledCoverageMap;

// Baked Coverage(r)/Type(g) cube (CloudCoverageMap.usf) — replaces the live CalculateWeatherMap FBM+warp
// call at every raymarch sample. WeatherMap only ever depends on direction from the planet center (not on
// radius — every call site below samples at a fixed radius per direction), so indexing purely by direction
// is exact, not an approximation.
TextureCube CloudGlobalCoverageMap;
SamplerState CloudGlobalCoverageMapSampler;

// Projects a flat 2D coverage texture (reusing the TiledCoverageMap slot — assign the HorizonClouds
// WeatherTexture asset into it) onto the sphere via a naive dominant-axis (cube-face-like) projection at a
// fixed 40km world tile. Returns the full RGBA, matching HorizonClouds' WeatherTexture layout exactly (r/g
// weather state, b height-ceiling, a density/precipitation gate) — SampleDensity below reads all 4 channels
// the same way HorizonClouds' verified SampleDensity does. Drop-in alternative source to
// CloudGlobalCoverageMap — used both by the case 6u visualization and by the actual raymarch.
float4 SampleTiledCoverage(float3 Direction, float3 Position)
{
	// Global coverage blending disabled again — tiled texture only, matching HorizonClouds' single-source
	// coverage. To re-enable: restore this sample (the saturate() matters — the raw bake goes negative, and
	// a negative weight makes the sqrt() in the return NaN) and blend it back in below.
	// const float CubeCoverageWeight = saturate(TextureCubeSample(CloudGlobalCoverageMap, CloudGlobalCoverageMapSampler, Direction).r);

	const float3 AbsDir = abs(Direction);
	float2 ProjectedUV;
	if (AbsDir.x >= AbsDir.y && AbsDir.x >= AbsDir.z)
	{
		ProjectedUV = Position.yz;
	}
	else if (AbsDir.y >= AbsDir.z)
	{
		ProjectedUV = Position.xz;
	}
	else
	{
		ProjectedUV = Position.xy;
	}

	const float TilingCoverageTileSize = 4000000.0; // 40km, matches HorizonClouds' verified WeatherTexTile
	const float4 TilingSample = (bHasTiledCoverageMap != 0u)
									? Texture2DSampleLevel(TiledCoverageMap, TiledCoverageMapSampler, ProjectedUV / TilingCoverageTileSize, 0)
									: float4(0., 0., 0., 1.);
	// To re-enable global coverage: return sqrt(saturate(TilingSample) * CubeCoverageWeight);
	return saturate(TilingSample);
}

// Standard remap: rescales Value from the [OldMin, OldMax] range to [NewMin, NewMax], clamped.
float Remap(float Value, float OldMin, float OldMax, float NewMin, float NewMax)
{
	return NewMin + saturate((Value - OldMin) / (OldMax - OldMin)) * (NewMax - NewMin);
}

// Ported verbatim from HorizonClouds' verified SampleDensity (HorizonClouds.usf), which is itself traced
// directly from the purchased VolumetricClouds plugin's M_VolumetricClouds.uasset material graph. Same
// formula, same tile scales (BaseNoiseTexTile=200,000 / SmallNoiseTexTile=17,391 — HorizonClouds'
// DEVLOG.md line 13), same WeatherMap channel layout — just reading BaseShapeNoiseTexture/DetailNoiseTexture
// (OrbisClouds' names for the same HorizonClouds-authored textures) and using SampleTiledCoverage in place
// of a plain 2D Position.xy sample, since Position here is relative to a sphere, not a flat box.
float SampleDensity(float3 Position, float3 Direction, float HeightGradient, float LOD)
{
	if (bHasBaseShapeNoiseTexture == 0u)
	{
		return lerp(0.8, 0.1, HeightGradient);
	}

	const float BaseNoiseTexTile = 200000.0;
	const float SmallNoiseTexTile = 17391.0;

	const float4 BaseNoise = Texture3DSampleLevel(BaseShapeNoiseTexture, BaseShapeNoiseSampler, Position / BaseNoiseTexTile, LOD);
	const float4 SmallNoise = (bHasDetailNoiseTexture != 0u)
								  ? Texture3DSampleLevel(DetailNoiseTexture, DetailNoiseSampler, Position / SmallNoiseTexTile, LOD)
								  : float4(0.0, 0.0, 0.0, 0.0);

	// Coverage is intentionally height-independent (WeatherMap only ever depends on direction from the
	// planet center, verified in HorizonClouds too) — sampled at a fixed InnerRadius reference regardless of
	// Position's actual (real, varying) radius, unlike the 3D noise above which needs the true height.
	float4 WeatherMap = SampleTiledCoverage(Direction, Direction * InnerRadius);

	const float2 WeatherParam = float2(0.65, 14.0);

	WeatherMap.b = saturate(WeatherMap.b + ((WeatherParam.x - 0.5) * 2.0));
	const float WeatherState = max(WeatherMap.r, saturate(WeatherParam.x - 0.5) * 2.0 * WeatherMap.g);

	const float ShapeAltering = saturate(Remap(HeightGradient, 0.0, 0.07, 0.0, 1.0)) * saturate(Remap(HeightGradient, WeatherMap.b * 0.2, WeatherMap.b, 1.0, 0.0));
	const float DensityAltering = WeatherParam.y * HeightGradient * saturate(Remap(HeightGradient, 0.0, 0.15, 0.0, 1.0)) * saturate(Remap(HeightGradient, 0.9, 1.0, 1.0, 0.0)) * WeatherMap.a * 2.0;

	const float BaseNoiseSample = Remap(BaseNoise.r, (BaseNoise.g * 0.625 + BaseNoise.b * 0.25 + BaseNoise.a * 0.125) - 1.0, 1.0, 0.0, 1.0);
	const float SmallNoiseSample = SmallNoise.r * 0.625 + SmallNoise.g * 0.25 + SmallNoise.b * 0.125;
	const float DetailNoise = 0.35 * exp(-WeatherParam.x * 0.75) * lerp(SmallNoiseSample, 1.0 - SmallNoiseSample, saturate(HeightGradient * 10.0));

	const float ShapeNoise = saturate(Remap(BaseNoiseSample * ShapeAltering, 1.0 - WeatherParam.x * WeatherState, 1.0, 0.0, 1.0));
	return saturate(Remap(ShapeNoise, DetailNoise, 1.0, 0.0, 1.0)) * DensityAltering;
}

void MainPS(
	in noperspective float4 UVAndScreenPos : TEXCOORD0,
	in float4 SvPosition : SV_Position,
	out float4 OutColor : SV_Target0)
{
	if (bDebugSolid != 0u)
	{
		OutColor = float4(1.0, 0.0, 1.0, 1.0);
		return;
	}

	const float2 UV = UVAndScreenPos.xy;
	const float2 ScreenPos = UVAndScreenPos.zw;
	const float3 RayOrigin = float3(0.0, 0.0, 0.0);
	const float3 RayDirection = ReconstructWorldRayDirection(ScreenPos);

	float tRaymarchEnter = 0.0;
	float tRaymarchExit = 0.0;
	float2 OuterRadiusHit = 0.0; // For Coverage/Type weather map view
	if (!IntersectAtmosphereShell(RayOrigin, RayDirection, PlanetCenterRelative, InnerRadius, OuterRadius, tRaymarchEnter, tRaymarchExit, OuterRadiusHit))
	{
		discard;
	}

	// Only clip by terrain depth for the actual raymarch (CloudsViewMode == 2) — Coverage/Type (0/1) are a
	// debug visualization of the weather map projected onto the outer sphere, they never read
	// tRaymarchEnter/tRaymarchExit, so terrain occlusion has nothing to do with them. Previously this ran
	// unconditionally and discarded Coverage/Type pixels whenever terrain was nearer than the shell (i.e.
	// whenever the camera was near the ground looking mostly at terrain) even though those modes don't use
	// the clipped segment at all — that was the black region reported near/below the outer radius.
	if (bDepthOcclusion != 0u) // && CloudsViewMode == 2u
	{
		const float SceneViewDepth = ConvertFromDeviceZ(Texture2DSampleLevel(SceneDepthTexture, SceneDepthSampler, UV, 0).r);
		const float SceneRayDistance = SceneDepthToRayDistance(SceneViewDepth, RayDirection);
		ClipShellBySceneDepth(tRaymarchEnter, tRaymarchExit, SceneRayDistance);

		if (tRaymarchExit <= tRaymarchEnter)
		{
			discard;
		}
	}

	// Project onto the outer sphere so coverage is constant through the layer, sampled at the outer
	// boundary regardless of whether the camera is outside the shell (orbit) or inside it (near/below
	// the inner radius). Reuses the outer-sphere hit IntersectAtmosphereShell already computed, rather
	// than re-intersecting it, and rather than reusing tRaymarchEnter/tRaymarchExit, which mix in inner-sphere clipping
	// and produce a discontinuity right at the inner-sphere silhouette.
	const float OuterShellPosition = (OuterRadiusHit.x > 0.0) ? OuterRadiusHit.x : OuterRadiusHit.y;

	// Was: normalize(RayDirection * OuterShellPosition - PlanetCenterRelative) — subtracts two float3
	// vectors that are both ~CameraDistanceFromPlanetCenter in magnitude and nearly parallel whenever the
	// camera is far outside the outer radius, losing the precision needed to recover their difference (the
	// flat white/grey "surface" bug seen from deep space). Fixed using UE's double-float math
	// (FDFVector3/FDFScalar) instead of float32 algebra — see ComputePreciseOuterSurfaceDirection in
	// OrbisClouds.ush, modeled on Epic's own RayPlanetIntersectPrecise for the path-traced atmosphere. It
	// reuses OuterShellPosition as-is rather than re-deriving the intersection independently, so it can't
	// disagree with IntersectAtmosphereShell's root selection above.
	const FDFVector3 PlanetCenterRelativeDF = MakeDFVector3(PlanetCenterRelativeHi, PlanetCenterRelativeLo);
	const float3 DirectionFromPlanetCenter = ComputePreciseDirectionFromPlanetCenter(RayDirection, OuterShellPosition, PlanetCenterRelativeDF);
	const float3 OuterSurfacePosition = DirectionFromPlanetCenter * OuterRadius;
	float2 WeatherMap = 0.;

	float Color = 0.;
	switch (CloudsViewMode)
	{
	case 0u:
	{
		// Was: a live CalculateWeatherMap(OuterSurfacePosition, OuterRadius, ...) call (8-octave Coverage FBM
		// + 8-octave Type FBM + up to 6-octave warp) — now a lookup into the baked cube (CloudCoverageMap.usf),
		// indexed by direction since WeatherMap only ever depends on direction from the planet center.
		WeatherMap = TextureCubeSample(CloudGlobalCoverageMap, CloudGlobalCoverageMapSampler, DirectionFromPlanetCenter).rg;
		Color = WeatherMap.x;
	}
	break;
	case 1u:
	{
		// Was: same live CalculateWeatherMap(OuterSurfacePosition, OuterRadius, ...) call as case 0u above.
		WeatherMap = TextureCubeSample(CloudGlobalCoverageMap, CloudGlobalCoverageMapSampler, DirectionFromPlanetCenter).rg;
		Color = WeatherMap.y;
	}
	break;
	case 3u:
		// TEMPORARY DEBUG: red = near root used (OuterRadiusHit.x > 0, camera outside), blue = far root used
		// (camera inside) — checking whether root selection flips somewhere across the screen, which would
		// explain a seam between correctly-textured and "ghost" flat regions.
		OutColor = (OuterRadiusHit.x > 0.0) ? float4(1., 0., 0., 1.) : float4(0., 0., 1., 1.);
		return;
	case 4u:
		// TEMPORARY DEBUG: green = bHasBaseShapeNoiseTexture is 1 (texture actually seen by the shader), red
		// = 0 (texture not seen, even though it's assigned in the editor) — isolating whether the fallback
		// density path is running because the texture genuinely isn't reaching the shader, vs some other bug
		// in SampleDensity itself once the texture is confirmed bound.
		OutColor = (bHasBaseShapeNoiseTexture != 0u) ? float4(0., 1., 0., 1.) : float4(1., 0., 0., 1.);
		return;
	case 5u:
	{
		// TEMPORARY DEBUG: raw BaseShapeNoise.x sampled on the outer sphere, no Remap/Coverage/Erosion
		// applied at all — isolating whether the moiré/parallel-line pattern seen in Clouds mode comes from
		// the texture sample itself (aliasing) or from the density math built on top of it.
		// Was: hardcoded 1.0 / 12000.0 — never actually linked to BaseShapeWorldSpan, so changing that
		// parameter had zero effect here even though it looked like a live test of it.
		const float BaseShapeFrequency = 1.0 / BaseShapeWorldSpan;
		const float4 RawBaseShapeNoise = Texture3DSampleLevel(BaseShapeNoiseTexture, BaseShapeNoiseSampler, OuterSurfacePosition * BaseShapeFrequency, 0);
		OutColor = float4(RawBaseShapeNoise.xxx, 1.0);
		return;
	}
	case 6u:
	{
		// TILING COVERAGE TEST: projects a flat 2D coverage texture (reusing the TiledCoverageMap slot —
		// assign the HorizonClouds WeatherTexture asset into it) onto the sphere at a fixed 80km world tile,
		// using a naive dominant-axis (cube-face-like) projection. Isolates whether this specific texture
		// shows visible tile repetition / cube-projection distortion at this scale, independent of the
		// CloudGlobalCoverageMap cube bake and its own (potentially different) projection.
		const float4 TiledWeatherMap = SampleTiledCoverage(DirectionFromPlanetCenter, OuterSurfacePosition);
		OutColor = float4(TiledWeatherMap.rrr, 1.0);
		return;
	}
	case 2u:
	{
		// RAYMARCH CODE — ported verbatim from HorizonClouds' verified MainPS (same structure the reference
		// VolumetricClouds plugin uses), adapted from box-local RayPos to sphere-shell t/direction. See
		// HorizonClouds.usf for the original.
		const float SegmentLength = tRaymarchExit - tRaymarchEnter;
		if (SegmentLength <= 0.0)
		{
			OutColor = float4(0., 0., 0., 0.0);
			return;
		}

		const float ShellThickness = OuterRadius - InnerRadius;
		const int StepCount = FindStepCount(SegmentLength, ShellThickness);

		const int RayMaxSteps = StepCount;
		const int ShadowMaxSteps = 8;
		const float StepScaleDistance = 5000000.; // 500000.0;
		const float MipMapScaleDistance = 100000000.0;
		const float LightStepScale = 2.0;

		const float BeerLawDensity = 0.85;
		const float AttenClampIntensity = 0.6;
		const float CloudOutScatterAmbient = 1.0;
		const float InScatter = 0.75;
		const float InScatterIntensity = 0.05;
		const float SilverLightExp = 1.0;
		const float SilverLightIntensity = 0.5;
		const float OutScatter = -0.045;
		const float InOutScatterLerp = 0.5;
		const float LightColorIntensity = 1.25;
		const float LightIntensity = 4.0;
		const float LightPow = 3.0;
		const float3 LightColor = float3(1.14, 1.22, 1.31) * LightColorIntensity;
		const float3 ShadowColor = float3(0.60, 0.63, 0.7);

		const float AtmosphereBlendDistance = 1000000000.0;
		const float AtmosphereBlendIntensity = 1.0;
		// Was: (0.5, 0.6, 0.7) — a 0.2 spread between R and B read as a distinctly blue wash rather than haze.
		// Brighter and much less saturated (0.08 spread): still atmosphere-tinted, but soft instead of blue.
		const float3 AtmosphereFogColor = float3(0.70, 0.73, 0.78);

		// Reused from HorizonClouds' verified material-instance value — not yet independently verified for
		// OrbisClouds' own scene, since there's no real scene directional light wired here yet.
		const float3 LightDir = float3(0.492453, -0.086837, 0.865996);

		// Near/far cascaded step budget: fixed 40km/500 step (matching TilingCoverageTileSize's own 40km
		// reference scale) for the first 500 iterations, then a coarser step for whatever budget remains up
		// to MaxIterations. Near phase resolves puff-scale detail close to the camera; far phase exists
		// purely to let grazing/horizon-tangent rays actually reach the shell within a bounded iteration
		// count, at the cost of resolution out there (same "thin screen-space strip, cheap to under-sample"
		// reasoning as HorizonClouds' own step-size inflation).
		const int NearPhaseSteps = 500;
		const float NearStepSize = 4000000.0 / 500.0; // 8,000 UU = 8m
		const float FarStepMultiplier = 8.0;		  // untuned starting guess — widen/narrow once tested at grazing angles
		const float FarStepSize = NearStepSize * FarStepMultiplier;

		const int3 JitterRandPos = int3(SvPosition.xy, View.StateFrameIndexMod8);
		const float Jitter = float(Rand3DPCG16(JitterRandPos).x) / 65536.0;
		float t = tRaymarchEnter + Jitter * NearStepSize;

		// t already IS distance-from-camera on this ray parametrization, unlike HorizonClouds' box-local
		// RayPos which needed length((RayPos-LocalRayOrigin).xy) to recover that distance. Computed once from
		// the entry point, same as HorizonClouds, then applied to whichever phase's base step is active.
		const float StepDistanceScale = clamp((t - StepScaleDistance) / StepScaleDistance, 0.0, 10.0);

		const float DotLight = dot(RayDirection, normalize(LightDir));

		float Transmittance = 1.0;
		float3 LightEnergy = 0.0;
		bool bZeroSample = false;
		float AtmosphereT = -1.0;

		const int MaxIterations = RayMaxSteps * 4;

		for (int Iteration = 0; Iteration < MaxIterations && t < tRaymarchExit; Iteration++)
		{
			const float PhaseStepSize = (Iteration < NearPhaseSteps) ? NearStepSize : FarStepSize;
			const float StepSize = PhaseStepSize + PhaseStepSize * StepDistanceScale;

			const float Radius = SampleRadiusAlongRay(t, RayDirection, PlanetCenterRelative);
			const float HeightGradient = (Radius - InnerRadius) / ShellThickness;

			float DensitySample = 0.0;
			float3 DirectionFromPlanetCenterAtStep = 0.0;
			float3 SamplePosition = 0.0;
			float MipMapDistanceScale = min(floor(t / MipMapScaleDistance), 5.0);

			if (HeightGradient >= 0.0 && HeightGradient <= 1.0)
			{
				DirectionFromPlanetCenterAtStep = ComputePreciseDirectionFromPlanetCenter(RayDirection, t, PlanetCenterRelativeDF);
				// Real, height-varying position — was DirectionFromPlanetCenterAtStep*InnerRadius (a constant
				// radius regardless of actual height), which collapsed the 3D noise to the same value across
				// the whole shell thickness and produced the smeared/stretched cloud-bottom artifact.
				SamplePosition = DirectionFromPlanetCenterAtStep * Radius;
				DensitySample = SampleDensity(SamplePosition, DirectionFromPlanetCenterAtStep, HeightGradient, MipMapDistanceScale);
			}

			if (DensitySample > 0.01)
			{
				if (bZeroSample)
				{
					bZeroSample = false;
					t -= StepSize;

					const float RadiusBack = SampleRadiusAlongRay(t, RayDirection, PlanetCenterRelative);
					const float HeightGradientBack = (RadiusBack - InnerRadius) / ShellThickness;
					if (HeightGradientBack >= 0.0 && HeightGradientBack <= 1.0)
					{
						MipMapDistanceScale = min(floor(t / MipMapScaleDistance), 5.0);
						DirectionFromPlanetCenterAtStep = ComputePreciseDirectionFromPlanetCenter(RayDirection, t, PlanetCenterRelativeDF);
						SamplePosition = DirectionFromPlanetCenterAtStep * RadiusBack;
						DensitySample = SampleDensity(SamplePosition, DirectionFromPlanetCenterAtStep, HeightGradientBack, MipMapDistanceScale);
					}
				}

				float DensityToSun = 0.0;
				float3 ShadowRayPos = SamplePosition;
				const float3 ShadowStep = normalize(LightDir) * NearStepSize * LightStepScale;
				for (int s = 0; s < ShadowMaxSteps; s++)
				{
					ShadowRayPos += ShadowStep;
					const float ShadowRadius = length(ShadowRayPos);
					const float ShadowHeightGradient = saturate((ShadowRadius - InnerRadius) / ShellThickness);
					const float MipMapShadowScale = floor(s / 2);
					DensityToSun += SampleDensity(ShadowRayPos, normalize(ShadowRayPos), ShadowHeightGradient, MipMapShadowScale);
				}

				const float AttenPrim = exp(-BeerLawDensity * DensityToSun);
				const float AttenSec = exp(-BeerLawDensity * AttenClampIntensity) * 0.7;
				const float SunAtten = Remap(DotLight, 0.0, 1.0, AttenSec, AttenSec * 0.5);
				const float Atten = max(SunAtten, AttenPrim);

				const float Depth = CloudOutScatterAmbient * pow(DensitySample, Remap(HeightGradient, 0.3, 0.9, 0.5, 1.0));
				const float Vertical = pow(saturate(Remap(HeightGradient, 0.0, 0.3, 0.8, 1.0)), 0.8);
				const float AmbientOutScatter = 1.0 - saturate(Depth * Vertical);

				const float FirstHG = InScatterIntensity * ((1.0 - InScatter * InScatter) / pow(1.0 + InScatter * InScatter - 2.0 * InScatter * DotLight, 1.5)) / 4.0 * 3.1415;
				const float SecondHG = SilverLightIntensity * pow(saturate(DotLight), SilverLightExp);
				const float InScatterHG = max(FirstHG, SecondHG);
				const float OutScatterHG = ((1.0 - OutScatter * OutScatter) / pow(1.0 + OutScatter * OutScatter - 2.0 * OutScatter * DotLight, 1.5)) / 4.0 * 3.1415;
				const float SunHighlight = lerp(InScatterHG, OutScatterHG, InOutScatterLerp);

				const float3 Light = Atten * AmbientOutScatter * SunHighlight * LightIntensity * DensitySample * Transmittance;
				LightEnergy += Light;
				Transmittance *= (1.0 - DensitySample);
			}

			if (AtmosphereT < 0.0)
			{
				AtmosphereT = t;
			}

			if (DensitySample > 0.0)
			{
				t += StepSize;
			}
			else
			{
				t += StepSize * 2.0;
				bZeroSample = true;
			}

			if (Transmittance <= 0.0)
			{
				Transmittance = 0.0;
				break;
			}
		}
		// raymarch end -------------------------------------------------------------------------------

		LightEnergy = pow(max(lerp(ShadowColor, LightColor, LightEnergy), 0.0), LightPow);
		const float AtmosphereBlendLerp = saturate(((max(AtmosphereT, 0.0) / AtmosphereBlendDistance) - 0.5) * AtmosphereBlendIntensity);
		LightEnergy = lerp(LightEnergy, AtmosphereFogColor, AtmosphereBlendLerp);

		OutColor = float4(LightEnergy, 1.0 - Transmittance);
		return;
	}
	}
	OutColor = float4(Color, Color, Color, 1.0);
}
