#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Engine/Private/InstancedStereo.ush"
#include "/Engine/Private/DoubleFloat.ush"
#include "/Engine/Private/RandomPCG.ush"
#include "/Plugin/OrbisClouds/Noise.ush"
#include "/Plugin/OrbisClouds/OrbisClouds.ush"

float3 PlanetCenterRelative;
float3 PlanetCenterRelativeHi;
float3 PlanetCenterRelativeLo;
float InnerRadius;
float OuterRadius;
float CloudDensity;
float CloudCoverageNoiseScale;
uint NoiseSeed;
uint BaseNoiseType;
float NoiseOutputMin;
float NoiseOutputMax;
int CloudsCoverageOctaves;
float CloudsCoverageLacunarity;
float CloudsCoverageGain;
uint bCloudsCoverageUseWarp;
float CloudsCoverageWarpStrength;
int CloudsCoverageWarpOctaves;
float CloudTypeNoiseScale;
uint CloudTypeNoiseSeed;
uint CloudTypeNoiseType;
int CloudsTypeOctaves;
float CloudsTypeLacunarity;
float CloudsTypeGain;
float BaseShapeWorldSpan;
uint CloudsViewMode;
uint bDebugSolid;
uint bDepthOcclusion;

Texture2D SceneDepthTexture;
SamplerState SceneDepthSampler;

Texture3D BaseShapeNoiseTexture;
SamplerState BaseShapeNoiseSampler;
Texture3D DetailNoiseTexture;
SamplerState DetailNoiseSampler;
uint bHasBaseShapeNoiseTexture;
uint bHasDetailNoiseTexture;
Texture2D CurlNoiseTexture;
SamplerState CurlNoiseSampler;
uint bHasCurlNoiseTexture;

// Baked Coverage(r)/Type(g) cube (CloudCoverageMap.usf) — replaces the live CalculateWeatherMap FBM+warp
// call at every raymarch sample. WeatherMap only ever depends on direction from the planet center (not on
// radius — every call site below samples at a fixed radius per direction), so indexing purely by direction
// is exact, not an approximation.
TextureCube CloudGlobalCoverageMap;
SamplerState CloudGlobalCoverageMapSampler;

// Tiling coverage test: projects a flat 2D coverage texture (reusing the CurlNoiseTexture slot — assign the
// HorizonClouds WeatherTexture asset into it) onto the sphere via a naive dominant-axis (cube-face-like)
// projection at a fixed 80km world tile. Returns (Coverage, Type) matching WeatherMap's layout, so it's a
// drop-in alternative source to CloudGlobalCoverageMap — used both by the case 6u visualization and, when
// selected, by the actual raymarch's WeatherMap sampling.
float2 SampleTiledCoverage(float3 Direction, float3 Position)
{
	// Weight, not gate: the baked cube map's raw (unsaturated) Coverage channel is the "how much weather
	// system here" signal from the already-tuned procedural generation — it can genuinely go negative
	// (NoiseOutputMin is user-exposed and defaults below 0). A hard >=0 cutoff produced a harsh binary
	// mask (blobby continents + salt-and-pepper speckle); multiplying by a saturated weight instead blends
	// smoothly, tapering the tiled texture's contribution down near zero instead of snapping it off.
	const float CubeCoverageWeight = TextureCubeSample(CloudGlobalCoverageMap, CloudGlobalCoverageMapSampler, Direction).r;

	const float3 AbsDir = abs(Direction);
	float2 ProjectedUV;
	if (AbsDir.x >= AbsDir.y && AbsDir.x >= AbsDir.z)
	{
		ProjectedUV = Position.yz;
	}
	else if (AbsDir.y >= AbsDir.z)
	{
		ProjectedUV = Position.xz;
	}
	else
	{
		ProjectedUV = Position.xy;
	}

	const float TilingCoverageTileSize = 4000000.0; // 80km
	const float4 TilingSample = (bHasCurlNoiseTexture != 0u)
									? Texture2DSampleLevel(CurlNoiseTexture, CurlNoiseSampler, ProjectedUV / TilingCoverageTileSize, 0)
									: float4(0., 0., 0., 1.);
	// Geometric mean (not a threshold-remap, not a flat multiply): sqrt(a*b) combines two [0,1] signals
	// without the "0.7*0.7=0.49" double-attenuation a flat multiply causes, and without the near-binary
	// steep threshold the division-based remap produced when CubeCoverageWeight was small (which is most
	// of a planet, since coverage is sparse) — that steepness was amplifying the tiled texture's own
	// high-frequency noise into the grainy/dithered "static" pattern seen on screen. This is smooth and
	// division-free everywhere, no epsilon guard needed.
	return sqrt(saturate(TilingSample.rg) * CubeCoverageWeight);
	// return TilingSample.rg;
}

// Standard remap: rescales Value from the [OldMin, OldMax] range to [NewMin, NewMax], clamped.
float Remap(float Value, float OldMin, float OldMax, float NewMin, float NewMax)
{
	return NewMin + saturate((Value - OldMin) / (OldMax - OldMin)) * (NewMax - NewMin);
}

// Beer's law: how much light survives passing through a given optical depth.
float BeersLaw(float OpticalDepth)
{
	return exp(-OpticalDepth);
}

// Henyey-Greenstein phase function: probability of light scattering toward the viewer at a given angle.
// G > 0 favors forward scattering (the "silver lining" toward the sun), G < 0 favors backward scattering.
float HenyeyGreenstein(float CosAngle, float G)
{
	const float G2 = G * G;
	return (1.0 - G2) / (4.0 * 3.1415927 * pow(1.0 + G2 - 2.0 * G * CosAngle, 1.5));
}

// Schneider's "powdered sugar" term (HZD 2015 talk, slides 58-64): darkens the edges facing the light,
// approximating the extra in-scattered light gathered deeper inside a cloud. Saturates faster than plain
// Beer's law (2x the exponent), so it punches through on thin/shallow edges instead of staying dark there.
float Powder(float OpticalDepth)
{
	return 1.0 - exp(-OpticalDepth * 2.0);
}

// cloudTest equivalent (Project-Marshmallow compute-clouds.comp:231-253, verified verbatim against source
// before implementing — see comment on Remap's caller below for the exact original). densityNoise there is
// our BaseShapeNoiseTexture (4-channel: R = base shape, GBA = Worley erosion octaves at increasing
// frequency). Coverage is NOT a flat multiplier on the final density — it's the threshold used inside a
// second remap on the erosion/fbm channels, which is what actually carves the shape.
// Defined here (not in OrbisClouds.ush) so it can reference BaseShapeNoiseTexture/BaseShapeNoiseSampler
// directly as globals — OrbisClouds.ush is #included above the texture global declarations, so a function
// living there can't see them without passing them in as parameters every call.
float CloudIsoVolumeLowRes(
	float3 SamplePosition,
	float InnerRadius,
	float2 WeatherMap,
	float HeightFromBottom,
	float HeightGradient)
{
	if (bHasBaseShapeNoiseTexture == 0u)
	{
		// No authored base-shape texture assigned — fall back to the plain height profile so this doesn't
		// just go silent.
		return lerp(0.8, 0.1, HeightGradient);
	}

	// Was: CloudCoverageNoiseScale / PlanetDiameter — tied the 128^3 texture's sampling frequency to planet
	// size, so at Small preset a raymarch step moved the sample position by a tiny fraction of one texel,
	// stretching the texture's actual detail across the whole planet diameter and never resolving it. Fixed
	// constant instead, independent of which preset is active — a cloud puff's physical size shouldn't
	// change depending on the preset button. Same tens-of-thousands-of-UU ballpark Marshmallow (2.5% of a
	// 2,000,000 UU planet = 50,000) and YVAN Volume 11 (fixed 600,000) actually use.
	// Was: hardcoded 12000.0, then BaseShapeWorldSpan (ImGui-exposed, defaulted to 17,000,000 = 170km) — 85x
	// too large compared to the verified reference scale below, which is exactly what produced the smooth,
	// blurry, no-puff-detail look diagnosed earlier. 200,000 UU (2km) is HorizonClouds' own verified
	// BaseNoiseTexTile (= BoxSizeX/NoiseTile = 4,000,000/20, traced directly from the reference material
	// graph — see HorizonClouds/Resources/DEVLOG.md line 13), a real individual-cloud-puff physical size.
	const float BaseShapeFrequency = 1.0 / 200000.0;
	const float4 BaseShapeNoise = Texture3DSampleLevel(BaseShapeNoiseTexture, BaseShapeNoiseSampler, SamplePosition * BaseShapeFrequency, 0);

	// calculate HeightSignal — verified from the purchased VolumetricClouds plugin's M_VolumetricClouds.uasset
	// (Content/Materials), structurally the same technique as HZD's own height-gradient: two remaps
	// multiplied together, using a continuous per-pixel height-ceiling scalar (their WeatherMap.b, our
	// WeatherMap.y) instead of blending between discrete Stratus/Cumulus/Cumulonimbus preset functions.
	// Was (verbatim):
	//   float ShapeAltering = saturate(Remap(HeightGradient, 0, 0.07, 0, 1))
	//                       * saturate(Remap(HeightGradient, WeatherMap.b * 0.2, WeatherMap.b, 1, 0));
	const float CloudTypeHeight = WeatherMap.y;
	const float HeightSignal = saturate(Remap(HeightGradient, 0.0, 0.07, 0.0, 1.0)) * saturate(Remap(HeightGradient, CloudTypeHeight * 0.2, CloudTypeHeight, 1.0, 0.0));

	// Was: Remap(..., 0.3, 1.0, 0.0, 1.0) — too restrictive, fought the coverage map's own shape (see below).
	// Then tried 0.05 — overcorrected the other way: let the base shape noise's own high-frequency grain
	// through everywhere as fine uniform static/speckle, drowning out the coverage map's shape entirely
	// instead of revealing it. 0.15 as a middle point between the two.
	float Density = Remap(BaseShapeNoise.x * HeightSignal, 0.15, 1.0, 0.0, 1.0);

	const float Erosion = 0.625 * BaseShapeNoise.y + 0.25 * BaseShapeNoise.z + 0.125 * BaseShapeNoise.w;
	const float ErosionStrength = 0.15;
	const float ErosionThreshold = Erosion * ErosionStrength;
	Density = Remap(Density, ErosionThreshold, 1.0, 0.0, 1.0);

	const float Coverage = WeatherMap.x;
	Density *= Coverage * (1. - HeightGradient);

	return Density;
}

float CloudHighRes(float3 SamplePosition, float OrigDensity, float HeightGradient, float Coverage)
{
	if (bHasDetailNoiseTexture == 0u)
	{
		return OrigDensity;
	}

	// Was: BaseShapeWorldSpan/8 — an arbitrary divisor, not verified against anything. HorizonClouds' actual
	// verified ratio is SmallNoiseTile/NoiseTile = 230/20 = 11.5, not 8. 17,391 UU (~174m) is HorizonClouds'
	// own verified SmallNoiseTexTile (= BoxSizeX/SmallNoiseTile = 4,000,000/230 — see
	// HorizonClouds/Resources/DEVLOG.md line 13), paired with the 200,000 UU base scale above.
	const float DetailShapeWorldSpan = 17391.0;
	const float DetailFrequency = 1.0 / DetailShapeWorldSpan;

	const float4 DetailNoise = Texture3DSampleLevel(DetailNoiseTexture, DetailNoiseSampler, SamplePosition * DetailFrequency, 0);

	float Erosion = 0.625 * DetailNoise.x + 0.25 * DetailNoise.y + 0.125 * DetailNoise.z;
	Erosion = lerp(Erosion, 1.0 - Erosion, saturate(HeightGradient * 10.0));

	const float HiResErosionStrength = 0.15; // 0.35 * exp(-Coverage * 0.75);
	return Remap(OrigDensity, Erosion * HiResErosionStrength, 1.0, 0.0, 1.0);
}

void MainPS(
	in noperspective float4 UVAndScreenPos : TEXCOORD0,
	in float4 SvPosition : SV_Position,
	out float4 OutColor : SV_Target0)
{
	if (bDebugSolid != 0u)
	{
		OutColor = float4(1.0, 0.0, 1.0, 1.0);
		return;
	}

	const float2 UV = UVAndScreenPos.xy;
	const float2 ScreenPos = UVAndScreenPos.zw;
	const float3 RayOrigin = float3(0.0, 0.0, 0.0);
	const float3 RayDirection = ReconstructWorldRayDirection(ScreenPos);

	float tRaymarchEnter = 0.0;
	float tRaymarchExit = 0.0;
	float2 OuterRadiusHit = 0.0; // For Coverage/Type weather map view
	if (!IntersectAtmosphereShell(RayOrigin, RayDirection, PlanetCenterRelative, InnerRadius, OuterRadius, tRaymarchEnter, tRaymarchExit, OuterRadiusHit))
	{
		discard;
	}

	// Only clip by terrain depth for the actual raymarch (CloudsViewMode == 2) — Coverage/Type (0/1) are a
	// debug visualization of the weather map projected onto the outer sphere, they never read
	// tRaymarchEnter/tRaymarchExit, so terrain occlusion has nothing to do with them. Previously this ran
	// unconditionally and discarded Coverage/Type pixels whenever terrain was nearer than the shell (i.e.
	// whenever the camera was near the ground looking mostly at terrain) even though those modes don't use
	// the clipped segment at all — that was the black region reported near/below the outer radius.
	if (bDepthOcclusion != 0u) // && CloudsViewMode == 2u
	{
		const float SceneViewDepth = ConvertFromDeviceZ(Texture2DSampleLevel(SceneDepthTexture, SceneDepthSampler, UV, 0).r);
		const float SceneRayDistance = SceneDepthToRayDistance(SceneViewDepth, RayDirection);
		ClipShellBySceneDepth(tRaymarchEnter, tRaymarchExit, SceneRayDistance);

		if (tRaymarchExit <= tRaymarchEnter)
		{
			discard;
		}
	}

	// Project onto the outer sphere so coverage is constant through the layer, sampled at the outer
	// boundary regardless of whether the camera is outside the shell (orbit) or inside it (near/below
	// the inner radius). Reuses the outer-sphere hit IntersectAtmosphereShell already computed, rather
	// than re-intersecting it, and rather than reusing tRaymarchEnter/tRaymarchExit, which mix in inner-sphere clipping
	// and produce a discontinuity right at the inner-sphere silhouette.
	const float OuterShellPosition = (OuterRadiusHit.x > 0.0) ? OuterRadiusHit.x : OuterRadiusHit.y;

	// Was: normalize(RayDirection * OuterShellPosition - PlanetCenterRelative) — subtracts two float3
	// vectors that are both ~CameraDistanceFromPlanetCenter in magnitude and nearly parallel whenever the
	// camera is far outside the outer radius, losing the precision needed to recover their difference (the
	// flat white/grey "surface" bug seen from deep space). Fixed using UE's double-float math
	// (FDFVector3/FDFScalar) instead of float32 algebra — see ComputePreciseOuterSurfaceDirection in
	// OrbisClouds.ush, modeled on Epic's own RayPlanetIntersectPrecise for the path-traced atmosphere. It
	// reuses OuterShellPosition as-is rather than re-deriving the intersection independently, so it can't
	// disagree with IntersectAtmosphereShell's root selection above.
	const FDFVector3 PlanetCenterRelativeDF = MakeDFVector3(PlanetCenterRelativeHi, PlanetCenterRelativeLo);
	const float3 DirectionFromPlanetCenter = ComputePreciseDirectionFromPlanetCenter(RayDirection, OuterShellPosition, PlanetCenterRelativeDF);
	const float3 OuterSurfacePosition = DirectionFromPlanetCenter * OuterRadius;
	float2 WeatherMap = 0.;

	float Color = 0.;
	switch (CloudsViewMode)
	{
	case 0u:
	{
		// Was: a live CalculateWeatherMap(OuterSurfacePosition, OuterRadius, ...) call (8-octave Coverage FBM
		// + 8-octave Type FBM + up to 6-octave warp) — now a lookup into the baked cube (CloudCoverageMap.usf),
		// indexed by direction since WeatherMap only ever depends on direction from the planet center.
		WeatherMap = TextureCubeSample(CloudGlobalCoverageMap, CloudGlobalCoverageMapSampler, DirectionFromPlanetCenter).rg;
		Color = WeatherMap.x;
	}
	break;
	case 1u:
	{
		// Was: same live CalculateWeatherMap(OuterSurfacePosition, OuterRadius, ...) call as case 0u above.
		WeatherMap = TextureCubeSample(CloudGlobalCoverageMap, CloudGlobalCoverageMapSampler, DirectionFromPlanetCenter).rg;
		Color = WeatherMap.y;
	}
	break;
	case 3u:
		// TEMPORARY DEBUG: red = near root used (OuterRadiusHit.x > 0, camera outside), blue = far root used
		// (camera inside) — checking whether root selection flips somewhere across the screen, which would
		// explain a seam between correctly-textured and "ghost" flat regions.
		OutColor = (OuterRadiusHit.x > 0.0) ? float4(1., 0., 0., 1.) : float4(0., 0., 1., 1.);
		return;
	case 4u:
		// TEMPORARY DEBUG: green = bHasBaseShapeNoiseTexture is 1 (texture actually seen by the shader), red
		// = 0 (texture not seen, even though it's assigned in the editor) — isolating whether the fallback
		// density path is running because the texture genuinely isn't reaching the shader, vs some other bug
		// in CloudIsoVolumeLowRes itself once the texture is confirmed bound.
		OutColor = (bHasBaseShapeNoiseTexture != 0u) ? float4(0., 1., 0., 1.) : float4(1., 0., 0., 1.);
		return;
	case 5u:
	{
		// TEMPORARY DEBUG: raw BaseShapeNoise.x sampled on the outer sphere, no Remap/Coverage/Erosion
		// applied at all — isolating whether the moiré/parallel-line pattern seen in Clouds mode comes from
		// the texture sample itself (aliasing) or from the density math built on top of it.
		// Was: hardcoded 1.0 / 12000.0 — never actually linked to BaseShapeWorldSpan, so changing that
		// parameter had zero effect here even though it looked like a live test of it.
		const float BaseShapeFrequency = 1.0 / BaseShapeWorldSpan;
		const float4 RawBaseShapeNoise = Texture3DSampleLevel(BaseShapeNoiseTexture, BaseShapeNoiseSampler, OuterSurfacePosition * BaseShapeFrequency, 0);
		OutColor = float4(RawBaseShapeNoise.xxx, 1.0);
		return;
	}
	case 6u:
	{
		// TILING COVERAGE TEST: projects a flat 2D coverage texture (reusing the CurlNoiseTexture slot —
		// assign the HorizonClouds WeatherTexture asset into it) onto the sphere at a fixed 80km world tile,
		// using a naive dominant-axis (cube-face-like) projection. Isolates whether this specific texture
		// shows visible tile repetition / cube-projection distortion at this scale, independent of the
		// CloudGlobalCoverageMap cube bake and its own (potentially different) projection.
		const float2 TiledWeatherMap = SampleTiledCoverage(DirectionFromPlanetCenter, OuterSurfacePosition);
		OutColor = float4(TiledWeatherMap.rrr, 1.0);
		return;
	}
	case 2u:
	{
		// RAYMARCH CODE------------------------------------------------------------------------
		const float SegmentLength = tRaymarchExit - tRaymarchEnter;
		if (SegmentLength <= 0.0)
		{
			OutColor = float4(0., 0., 0., 1.0);
			return;
		}

		const float ShellThickness = OuterRadius - InnerRadius;
		const int StepCount = FindStepCount(SegmentLength, ShellThickness);
		// Was: OrgStepSize = SegmentLength / StepCount — step size scaled with total ray length, same class
		// of bug fixed in HorizonClouds (a long/grazing SegmentLength forces huge steps regardless of how
		// fine the noise actually is). Now that BaseShapeFrequency resolves 2km puffs, that old formula
		// aliases badly — the thin spiky streaks and sparse scattered marks are undersampling, not a
		// coverage problem. Fixed step size instead, tied to the verified puff scale (200,000 UU / 8 =
		// 25,000 UU = 25m — a fraction of a single puff, not of the whole segment), falling back to the old
		// segment-divided formula only for short segments where a 25m step would be coarser than the
		// segment itself. StepCount still sets the iteration budget via MaxIterations below.
		const float FixedStepSize = 25000.0;
		const float OrgStepSize = (SegmentLength >= FixedStepSize * 2.0) ? FixedStepSize : ((SegmentLength / StepCount) * 2.0);
		float StepSize = OrgStepSize;
		// Was: a Density-weighted post-hoc average (WeightedLight/AccumDensity) — reverted from a full
		// SigmaT-based analytic integrator earlier this session because THAT blew up (saturate() turned
		// per-step spikes into solid white patches). This is a different, simpler technique: standard
		// front-to-back alpha compositing (the "over" operator), verified against the purchased
		// VolumetricClouds plugin's actual M_VolumetricClouds.uasset material (Transmittance *= 1-DensitySample
		// per step, LightEnergy += Transmittance*Density*Light). It's numerically safe here because Density is
		// already saturate()-clamped to [0,1] everywhere upstream, so 1-Density can't go negative and
		// Transmittance can only monotonically shrink — no exponential blow-up like the reverted attempt.
		// A post-hoc average washes out per-step variation into one flat blended brightness for the whole ray,
		// which is why the cloud read as flat with no internal shading — compositing keeps each step's
		// contribution weighted by how much light could still reach the camera through everything already
		// passed, which is what actually produces a sense of depth/form.
		// Scalar, not float3 — Color/OutColor downstream is still a plain grayscale luminance value (no sky/sun
		// color tinting yet, that's a separate, explicitly out-of-scope piece), so there's no RGB to carry.
		float Transmittance = 1.0;
		float AccumLight = 0.0;

		// Was: hardcoded float3(0.4, 0.6, 0.7) — ResolvedView.AtmosphereLightDirection[0] read black despite a
		// correctly-configured Directional Light (that field needs a SkyAtmosphere component to populate).
		// PrimaryView.DirectionalLightDirection is set directly from the scene's directional light instead.
		// TEMPORARY test: back to hardcoded, to isolate whether the lack of shading is the light march itself
		// or specifically PrimaryView.DirectionalLightDirection being zero/NaN.
		const float3 SunDirection = normalize(float3(1.0, 1.0, 1.0));
		const float CosAngle = dot(RayDirection, SunDirection); // constant along the whole ray
		const float HGPeak = HenyeyGreenstein(1.0, 0.2);

		// Iteration is a plain integer safety net, independent of t: for near-tangent rays SegmentLength (and
		// so StepSize) can be tiny, and if t is large enough that t + StepSize rounds back to t in float32,
		// t never advances and "t < tRaymarchExit" alone would loop forever (GPU hang / driver crash).
		// Iteration always increases by exactly 1 regardless of what t does, so it guarantees the loop ends.
		int Iteration = 0;
		// YVAN's fine-stepping (halve on hit, double on miss, both bounded relative to OrgStepSize) needs more
		// iterations than a plain coarse-only march to actually resolve density once found.
		const int MaxIterations = StepCount * 4;
		int ZeroDensityHitCount = 0;

		// Per-pixel start jitter (same mechanism as HorizonClouds): without it, the fixed 25m step lattice
		// samples the noise texture at exactly the same phase every ray, beating against the texture's own
		// texel grid (~15.6m base, ~5.4m detail) and producing uniform TV-static speckle instead of coherent
		// shape. Offsetting the starting t by a random fraction of one step decorrelates adjacent pixels.
		const int3 JitterRandPos = int3(SvPosition.xy, View.StateFrameIndexMod8);
		const float Jitter = float(Rand3DPCG16(JitterRandPos).x) / 65536.0;
		const float tJittered = tRaymarchEnter + Jitter * StepSize;

		for (float t = tJittered; t < tRaymarchExit && Iteration < MaxIterations; t += StepSize, Iteration++)
		{
			const float Radius = SampleRadiusAlongRay(t, RayDirection, PlanetCenterRelative);
			const float HeightFromBottom = (Radius - InnerRadius);
			const float HeightGradient = HeightFromBottom / ShellThickness;
			if (HeightGradient < 0.0 || HeightGradient > 1.0)
			{
				continue;
			}

			const float3 DirectionFromPlanetCenterAtStep = ComputePreciseDirectionFromPlanetCenter(RayDirection, t, PlanetCenterRelativeDF);
			const float3 SamplePosition = DirectionFromPlanetCenterAtStep * InnerRadius;

			WeatherMap = SampleTiledCoverage(DirectionFromPlanetCenterAtStep, SamplePosition);

			float Density = CloudIsoVolumeLowRes(SamplePosition, InnerRadius, WeatherMap, HeightFromBottom, HeightGradient);

			if (Density > 0.0)
			{
				// YVAN's fine-stepping: halve the step size on a hit, floored at OrgStepSize/8 so it can't
				// shrink forever.
				const float PreviousStepSize = StepSize;
				StepSize = max(StepSize / 2.0, OrgStepSize / 8.0);
				ZeroDensityHitCount = 0;

				// First hit while still fully coarse: this coarse step already overshot the true entry
				// boundary by up to a full OrgStepSize — step back and re-approach at the just-halved step
				// instead of accumulating this coarse-resolution sample.
				if (PreviousStepSize == OrgStepSize)
				{
					t -= PreviousStepSize;
					continue;
				}

				// Refine with the hi-res detail texture — only reached once genuinely in fine-stepping (the
				// step-back case above already continued away), so the coarse search never pays for this.
				Density = CloudHighRes(SamplePosition, Density, HeightGradient, WeatherMap.x);

				float DensityAlongLight = 0.0;
				float3 LightSamplePosition = SamplePosition;
				const float LightStepSize = 3.0 * StepSize;
				for (int LightStep = 0; LightStep < 6; LightStep++)
				{
					const float LightRadius = length(LightSamplePosition);
					const float LightHeightGradient = saturate((LightRadius - InnerRadius) / ShellThickness);
					float IsoVolumeTest = CloudIsoVolumeLowRes(LightSamplePosition, InnerRadius, WeatherMap, 0.0, LightHeightGradient);
					if (IsoVolumeTest > 0.0)
					{
						float LightDensity = CloudHighRes(LightSamplePosition, IsoVolumeTest, LightHeightGradient, WeatherMap.x);
						DensityAlongLight += LightDensity;
					}
					LightSamplePosition += SunDirection * LightStepSize;
				}

				const float BeersPowder = max(BeersLaw(DensityAlongLight), Powder(DensityAlongLight));
				const float SunHighlight = HenyeyGreenstein(CosAngle, 0.2) / HGPeak;

				const float Depth = pow(Density, lerp(0.5, 1.0, saturate(Remap(HeightGradient, 0.3, 0.9, 0.0, 1.0))));
				const float Vertical = pow(saturate(Remap(HeightGradient, 0.0, 0.3, 0.8, 1.0)), 0.8);
				const float AmbientOutScatter = 1.0 - saturate(Depth * Vertical);

				const float LightEnergy = BeersPowder * AmbientOutScatter * SunHighlight;

				AccumLight += Transmittance * Density * LightEnergy;
				Transmittance *= (1.0 - Density);
				if (Transmittance < 0.01)
				{
					Transmittance = 0.0;
					break;
				}
			}
			else if (StepSize < OrgStepSize)
			{
				// Marshmallow-style gating on top of YVAN's doubling: a single miss doesn't start reverting
				// to coarse — only 10 consecutive misses (actually walking out of the cloud, not just a brief
				// internal gap) does, to avoid a coarse silhouette bleeding through behind finer foreground
				// detail ("big cloud behind small cloud").
				ZeroDensityHitCount++;
				if (ZeroDensityHitCount >= 10)
				{
					StepSize = min(StepSize * 2.0, OrgStepSize * 2.);
				}
			}
		}
		// raymarch end -------------------------------------------------------------------------------

		// Opacity is what's left after Transmittance's multiplicative decay (1 = fully opaque, nothing of the
		// background survives); AccumLight is already the fully-composited front-to-back light sum, not an
		// average, so it's used directly rather than divided by anything.
		const float Opacity = saturate(1.0 - Transmittance);
		Color = saturate(AccumLight);
	}
	break;
	}
	OutColor = float4(Color, Color, Color, 1.0);
}
